# Copy to .env.local and fill in from Supabase → Project Settings → API.
# The anon/publishable key is safe in the browser: row level security protects the data.
# NEVER put the service_role / secret key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Free USDA FoodData Central key (https://fdc.nal.usda.gov/api-key-signup). Read-only public data; it ends up
# in the app bundle (accepted). Without it the app uses USDA's shared DEMO_KEY (very limited).
VITE_USDA_API_KEY=
